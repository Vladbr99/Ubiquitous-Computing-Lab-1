<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <Button
        android:id="@+id/buttonPlayAgain"
        android:layout_width="93dp"
        android:layout_height="58dp"
        android:layout_below="@+id/textFeedback"
        android:layout_marginStart="199dp"
        android:layout_marginTop="40dp"
        android:layout_toEndOf="@+id/buttonGuess"
        android:text="Play Again" />

    <TextView
        android:id="@+id/textTitle"
        android:layout_width="351dp"
        android:layout_height="62dp"
        android:layout_marginTop="24dp"
        android:text="Guess the number between 1 and 30"
        android:textSize="20sp" />

    <EditText
        android:id="@+id/editGuess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/textTitle"
        android:layout_marginTop="8dp"
        android:hint="Enter your guess"
        android:inputType="number" />

    <!-- MOVED UP: must appear before anything that references it -->
    <TextView
        android:id="@+id/textFeedback"
        android:layout_width="170dp"
        android:layout_height="32dp"
        android:layout_below="@id/editGuess"
        android:layout_marginTop="1dp"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/textGuessCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/textFeedback"
        android:layout_marginTop="6dp"
        android:text="Guesses: 0"
        android:textSize="16sp" />

    <Button
        android:id="@+id/buttonGuess"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/textFeedback"
        android:layout_marginTop="39dp"
        android:text="Guess" />

    <!-- FIXED: removed negative margin -->
    android:layout_toEndOf="@id/buttonGuess"
    android:enabled="false"
    android:text="Play Again" />

</RelativeLayout>
